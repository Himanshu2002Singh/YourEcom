# Copy to backend/.env and fill in. Never commit .env.
# Local MySQL: mysql://USER:PASSWORD@localhost:3306/yourecom  (run `npm run db:setup` once to create it)
# A password with symbols such as @ : / # % needs them URL-encoded (@ becomes %40).
DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/yourecom
# Cloud MySQL (e.g. TiDB Cloud) needs TLS: append ?ssl={"rejectUnauthorized":true} to the URL.

# Long random string (32+ characters) that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Email for password-reset links. Leave SMTP_URL empty in development to print emails to the
# console instead. Production needs SMTP_URL and APP_URL, for example Gmail with an app password:
#   SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=YourEcom <hello@yourecom.in>
# The storefront's address, which links in emails start with (no trailing slash).
APP_URL=http://localhost:5173
