# Copy to backend/.env and fill in. Never commit .env.
# A value left empty turns that feature off, as each section says.

# ---------- Server ----------
# Port the API listens on (nginx forwards to it).
PORT=4000
# Set to production on the server: session cookies become Secure and password-reset emails need SMTP_URL and APP_URL.
NODE_ENV=
# Folder for the product photos admins upload. Empty means backend/uploads; on a server, pick a folder that
# survives deploys.
UPLOAD_DIR=

# ---------- Database ----------
# Local MySQL: mysql://USER:PASSWORD@localhost:3306/yourecom  (run `npm run db:setup` once to create it)
# A password with symbols such as @ : / # % needs them URL-encoded (@ becomes %40).
DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/yourecom
# Cloud MySQL (e.g. TiDB Cloud) needs TLS: append ?ssl={"rejectUnauthorized":true} to the URL.

# ---------- Sessions ----------
# Long random string (32+ characters) that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- Email ----------
# Email for password-reset links. Leave SMTP_URL empty in development to print emails to the
# console instead. Production needs SMTP_URL and APP_URL, for example Gmail with an app password:
#   SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=YourEcom <hello@yourecom.in>
# The storefront's address, which links in emails start with (no trailing slash). On the server: https://youre-com.com
APP_URL=http://localhost:5173

# ---------- Sign in with Google ----------
# The OAuth client ID (type Web application) from Google Cloud Console, APIs & Services > Credentials. Its authorised
# JavaScript origins must include the storefront's address: http://localhost:5173 locally, and https://youre-com.com
# and https://www.youre-com.com on the live site. Leave it empty and the storefront hides the Google button.
GOOGLE_CLIENT_ID=

# ---------- Online payments (Razorpay) ----------
# API keys from the Razorpay Dashboard > Account & Settings > API Keys. Test keys (rzp_test_...) take test payments
# only; live keys (rzp_live_...) work once Razorpay has approved the business (KYC). Leave both empty and checkout
# offers cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks > Add new webhook: URL https://api.youre-com.com/api/payments/razorpay/webhook,
# event payment.captured, and a secret you choose; put the same secret here. It confirms a payment even when the
# customer closes the page before getting back to the store.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Store owner's admin account ----------
# On start the API creates this account as an admin if no account uses the email yet. An existing account is left
# alone: make it an admin with `npm run admin -- <email>`. The password is only used to create the account, so
# change it later from the profile page, not here. Use a long password (12+ characters). Leave both empty to
# manage admins with `npm run admin` only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
